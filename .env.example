# Neon PostgreSQL Database
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?channel_binding=require&sslmode=require
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Neon Auth Configuration
# Get your Neon Auth Base URL from the Neon Console -> Auth -> Settings
NEON_AUTH_BASE_URL=https://ep-your-subdomain.neonauth.region.aws.neon.tech/neondb/auth
# Minimum 32-character secret for signing session cookies
NEON_AUTH_COOKIE_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Application URL
NEXT_PUBLIC_APP_URL=https://checkmargin.netlify.app

# Payment Gateway (Razorpay/Cashfree for SaaS Subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
